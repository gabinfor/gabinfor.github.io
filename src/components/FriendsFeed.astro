---
import { getBlogrollPosts } from '../lib/feeds';
import { isoDate } from '../lib/format';
interface Props { limit?: number; perBlog?: number }
const { limit = 8, perBlog = 2 } = Astro.props;
// Cap each blog so prolific writers don't crowd everyone else out.
const seen = new Map<string, number>();
const items = (await getBlogrollPosts()).filter((i) => {
  const n = (seen.get(i.blog.url) ?? 0) + 1;
  seen.set(i.blog.url, n);
  return n <= perBlog;
}).slice(0, limit);
---
{items.length === 0 ? (
  <p class="muted">Couldn't reach any feeds during this build.</p>
) : (
  <ul class="friends">
    {items.map((i) => (
      <li>
        <span aria-hidden="true">►</span>
        <a href={i.link} rel="noopener">{i.title}</a>
        <span class="muted"> · {i.blog.name}{i.date && !isNaN(+i.date) && <> · <span class="date">{isoDate(i.date)}</span></>}</span>
      </li>
    ))}
  </ul>
)}
<style>
  .friends { list-style: none; padding: 0; margin: 0; }
  li { padding: 4px 0 4px 18px; text-indent: -18px; font-size: 13px; }
  li > span:first-child { color: var(--accent); display: inline-block; width: 18px; text-indent: 0; }
</style>
