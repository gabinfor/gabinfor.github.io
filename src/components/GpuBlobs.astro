---
// A raymarched metaball scene rendered with WebGPU. Follows the pointer,
// pauses when off-screen, and falls back to a CSS gradient without WebGPU.
// `pixel` renders at 1/pixel resolution for a chunky look (1 = full res).
interface Props { height?: string; hue?: number; caption?: string; pixel?: number }
const { height = '420px', hue = 0, caption, pixel = 3 } = Astro.props;
---
<figure class="gpu" style={`--h:${height}`} data-hue={hue} data-pixel={pixel}>
  <canvas aria-label="Interactive 3D blobs that follow your pointer"></canvas>
  <p class="fallback" hidden>WebGPU isn't available in this browser. Try a recent Chrome, Edge, or Safari.</p>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .gpu { margin: 2rem 0; position: relative; }
  canvas {
    width: 100%; height: var(--h); touch-action: none; cursor: crosshair; image-rendering: pixelated;
    background: var(--sunken); border: 2px solid var(--border); box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.5);
  }
  .gpu.no-gpu canvas {
    background: radial-gradient(circle at 35% 40%, var(--accent), transparent 45%),
                radial-gradient(circle at 65% 60%, #7a5cff, transparent 40%);
    filter: blur(20px); opacity: 0.6;
  }
  .fallback { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 1rem; }
  .fallback[hidden] { display: none; }
  figcaption { margin-top: 6px; font-size: 12px; color: var(--win-muted); }
  .fallback { color: #fff; }
</style>

<script>
  const SHADER = /* wgsl */ `
    struct U { res: vec2f, mouse: vec2f, time: f32, hue: f32, pad: vec2f };
    @group(0) @binding(0) var<uniform> u: U;

    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
      var p = array<vec2f, 3>(vec2f(-1., -3.), vec2f(-1., 1.), vec2f(3., 1.));
      return vec4f(p[i], 0., 1.);
    }

    fn smin(a: f32, b: f32, k: f32) -> f32 {
      let h = clamp(0.5 + 0.5 * (b - a) / k, 0., 1.);
      return mix(b, a, h) - k * h * (1. - h);
    }

    fn map(p: vec3f) -> f32 {
      let t = u.time;
      var d = length(p) - 0.8;
      for (var i = 0; i < 5; i++) {
        let fi = f32(i);
        let o = vec3f(sin(t * 0.7 + fi * 1.7), cos(t * 0.5 + fi * 2.3), sin(t * 0.6 + fi * 0.9)) * 1.15;
        d = smin(d, length(p - o) - 0.42, 0.6);
      }
      let aspect = u.res.x / u.res.y;
      let m = vec3f((u.mouse.x - 0.5) * 3.2 * aspect, (0.5 - u.mouse.y) * 3.2, 0.6);
      return smin(d, length(p - m) - 0.33, 0.55);
    }

    fn calcNormal(p: vec3f) -> vec3f {
      let e = vec2f(0.001, 0.);
      return normalize(vec3f(
        map(p + e.xyy) - map(p - e.xyy),
        map(p + e.yxy) - map(p - e.yxy),
        map(p + e.yyx) - map(p - e.yyx)));
    }

    @fragment fn fs(@builtin(position) fc: vec4f) -> @location(0) vec4f {
      let uv = (fc.xy - 0.5 * u.res) / u.res.y * vec2f(1., -1.);
      // pull the camera back on portrait canvases so nothing gets cropped
      let ro = vec3f(0., 0., 4.5 / min(u.res.x / u.res.y, 1.));
      let rd = normalize(vec3f(uv, -1.5));
      var t = 0.;
      var hit = false;
      for (var i = 0; i < 90; i++) {
        let d = map(ro + rd * t);
        if (d < 0.001) { hit = true; break; }
        t += d;
        if (t > 12.) { break; }
      }
      if (!hit) { return vec4f(0.); }
      let p = ro + rd * t;
      let n = calcNormal(p);
      let l = normalize(vec3f(0.6, 0.8, 0.5));
      let dif = max(dot(n, l), 0.);
      let fres = pow(1. - max(dot(n, -rd), 0.), 3.);
      let base = 0.5 + 0.5 * cos(6.2831 * (vec3f(0., 0.33, 0.67) + n.y * 0.35 + u.time * 0.04 + u.hue));
      var col = base * (0.25 + 0.75 * dif) + fres * vec3f(1., 0.45, 0.2);
      col += pow(max(dot(reflect(-l, n), -rd), 0.), 40.) * 0.7;
      return vec4f(col, 1.);
    }
  `;

  async function start(fig: HTMLElement) {
    const canvas = fig.querySelector('canvas')!;
    const fail = () => { fig.classList.add('no-gpu'); fig.querySelector<HTMLElement>('.fallback')!.hidden = false; };
    if (!('gpu' in navigator)) return fail();
    const adapter = await navigator.gpu.requestAdapter();
    if (!adapter) return fail();
    const device = await adapter.requestDevice();
    const ctx = canvas.getContext('webgpu');
    if (!ctx) return fail();
    const format = navigator.gpu.getPreferredCanvasFormat();
    ctx.configure({ device, format, alphaMode: 'premultiplied' });

    const module = device.createShaderModule({ code: SHADER });
    const pipeline = device.createRenderPipeline({
      layout: 'auto',
      vertex: { module, entryPoint: 'vs' },
      fragment: { module, entryPoint: 'fs', targets: [{ format }] },
    });
    const ubuf = device.createBuffer({ size: 32, usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST });
    const bind = device.createBindGroup({ layout: pipeline.getBindGroupLayout(0), entries: [{ binding: 0, resource: { buffer: ubuf } }] });

    const data = new Float32Array(8);
    const hue = Number(fig.dataset.hue ?? 0);
    const pixel = Number(fig.dataset.pixel ?? 1);
    const mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = true, raf = 0;

    new ResizeObserver(() => {
      const scale = pixel === 1 ? Math.min(devicePixelRatio, 2) : 1 / pixel;
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * scale));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * scale));
    }).observe(canvas);
    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.tx = (e.clientX - r.left) / r.width;
      mouse.ty = (e.clientY - r.top) / r.height;
    });
    canvas.addEventListener('pointerleave', () => { mouse.tx = 0.5; mouse.ty = 0.5; });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf) raf = requestAnimationFrame(frame);
    }).observe(canvas);

    const t0 = performance.now();
    function frame(now: number) {
      raf = 0;
      if (!visible) return;
      mouse.x += (mouse.tx - mouse.x) * 0.08;
      mouse.y += (mouse.ty - mouse.y) * 0.08;
      data.set([canvas.width, canvas.height, mouse.x, mouse.y, still ? 2 : (now - t0) / 1000, hue]);
      device.queue.writeBuffer(ubuf, 0, data);
      const enc = device.createCommandEncoder();
      const pass = enc.beginRenderPass({
        colorAttachments: [{ view: ctx!.getCurrentTexture().createView(), loadOp: 'clear', storeOp: 'store', clearValue: [0, 0, 0, 0] }],
      });
      pass.setPipeline(pipeline);
      pass.setBindGroup(0, bind);
      pass.draw(3);
      pass.end();
      device.queue.submit([enc.finish()]);
      raf = requestAnimationFrame(frame);
    }
  }

  document.querySelectorAll<HTMLElement>('figure.gpu').forEach((f) => start(f).catch((err) => {
    console.error(err);
    f.classList.add('no-gpu');
    f.querySelector<HTMLElement>('.fallback')!.hidden = false;
  }));
</script>
