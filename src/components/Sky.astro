---
// Full-page pixel-art sky synced to the visitor's local time, with weather and fireworks.
// Preview with ?hour=21.5 and/or ?weather=storm. The engine lives in src/sky/.
---
<div class="sky" aria-hidden="true" transition:persist="sky"><canvas class="base"></canvas><canvas class="bloom"></canvas></div>

<style>
  .sky { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
  canvas { position: absolute; top: 0; left: 0; image-rendering: pixelated; max-width: none; }
  /* Bloom: only the light sources, blurred and screen-blended over the scene (all on the GPU). */
  .bloom { filter: blur(6px) brightness(1.8) saturate(1.4); mix-blend-mode: screen; }
  :global(html[data-bloom='off']) .bloom { display: none; }
</style>

<script>
  import '../sky/index';
</script>
