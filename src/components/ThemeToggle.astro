<button class="theme mono" type="button" aria-label="Toggle dark mode">◐</button>
<style>
  .theme { background: none; border: 1px solid var(--rule); color: var(--ink); border-radius: 99px; width: 2.1rem; height: 2.1rem; cursor: pointer; font-size: 1rem; }
  .theme:hover { border-color: var(--accent); color: var(--accent); }
</style>
<script>
  document.querySelector('.theme')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>
