---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
// `persist`: keep this window (and its state) alive across client-side page navigations.
interface Props { title: string; icon?: IconName; class?: string; tag?: 'section' | 'main' | 'aside'; persist?: string }
const { title, icon, class: className, tag: Tag = 'section', persist } = Astro.props;
---
<Tag class:list={['window', className]} data-astro-transition-persist={persist}>
  <div class="titlebar">
    <span class="tb-title">{icon && <Icon name={icon} size={14} />} {title}</span>
    <span class="tb-btns">
      <button type="button" class="tb-btn" data-win="min" aria-label="Minimize" aria-expanded="true"><Icon name="minimize" size={8} /></button>
      <button type="button" class="tb-btn" data-win="close" aria-label="Close"><Icon name="close" size={8} /></button>
    </span>
  </div>
  <div class="win-body"><slot /></div>
</Tag>
