---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Sky from '../components/Sky.astro';
import Window from '../components/Window.astro';
import Badge88 from '../components/Badge88.astro';
import Radio from '../components/Radio.astro';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';
import { SITE } from '../data/site';
import { BLOGROLL } from '../data/blogroll';

interface Props { title?: string; description?: string }
const { title, description = SITE.tagline } = Astro.props;
const fullTitle = title ? `${title} :: ${SITE.title}` : `${SITE.title}'s homepage`;
const path = Astro.url.pathname;
const nav: { href: string; label: string; icon: IconName }[] = [
  { href: '/', label: 'home', icon: 'home' },
  { href: '/about/', label: 'about', icon: 'person' },
  { href: '/blog/', label: 'writing', icon: 'pencil' },
  { href: '/lab/', label: 'lab', icon: 'flask' },
  { href: '/blogroll/', label: 'blogroll', icon: 'globe' },
  { href: '/rss.xml', label: 'rss', icon: 'rss' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const latest = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date)[0];
---
<!doctype html>
<!--
  hey, view-source explorer! this site is hand-made with Astro.
  psst: try the konami code, or type "rain" anywhere on the page.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="blogroll" type="text/xml" href="/blogroll.opml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Client-side navigation: the sky, status box and radio keep running between pages. -->
    <ClientRouter fallback="none" />
    <link rel="preload" href="/fonts/monocraft-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/monocraft-bold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Sky math lives here so the colour scheme is right before first paint. -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search).get('hour');
        window.__skyOverride = q !== null && q !== '' && !isNaN(+q) ? ((+q % 24) + 24) % 24 : null;
        window.__skyHour = function () {
          var d = new Date();
          return d.getHours() + d.getMinutes() / 60 + d.getSeconds() / 3600;
        };
        window.__skyMath = function (h) {
          var sunP = (h - 6) / 13.5, moonP = ((h - 19.5 + 24) % 24) / 10.5;
          var e = sunP >= 0 && sunP <= 1 ? Math.sin(Math.PI * sunP) : -Math.sin(Math.PI * Math.min(moonP, 1));
          var s = Math.min(1, Math.max(0, (e + 0.15) / 0.4)); s = s * s * (3 - 2 * s);
          var n = 1 - s;
          var phase = n > 0.6 ? 'night' : e < 0.35 ? (h < 12 ? 'dawn' : 'dusk') : 'day';
          var label = h < 5 ? 'late night' : h < 7.5 ? 'dawn' : h < 12 ? 'morning' : h < 17 ? 'afternoon' : h < 19.5 ? 'golden hour' : h < 21 ? 'dusk' : 'night';
          return { sunP: sunP, moonP: moonP, e: e, n: n, phase: phase, label: label };
        };
        try {
          if (localStorage.getItem('bloom') === 'off') document.documentElement.dataset.bloom = 'off';
          if (localStorage.getItem('glass') === 'off') document.documentElement.dataset.glass = 'off';
          if (localStorage.getItem('mc') === 'on') document.documentElement.dataset.mc = 'on';
        } catch (e) {}
        var h = window.__skyOverride !== null ? window.__skyOverride : window.__skyHour();
        document.documentElement.dataset.phase = window.__skyMath(h).phase;
      })();
    </script>
  </head>
  <body>
    <Sky />
    <div class="page">
      <header class="banner">
        <a class="site-title" href="/">{SITE.title}'s homepage</a>
        <p class="sub">{SITE.tagline}</p>
      </header>

      <div class="marquee window" aria-label="News ticker" transition:persist="ticker">
        <span>
          ★ welcome, traveller! ★ the sky up there matches the time where you are ★
          {latest && <>newest post: <a href={`/blog/${latest.id}/`}>{latest.data.title}</a> ★ </>}
          click things, they make noises ★ psst… try clicking the night sky ★
        </span>
      </div>

      <div class="layout">
        <Window title="navigation" icon="menu" class="nav">
          <nav class="nav-btns">
            {nav.map((n) => (
              <a class="btn" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                <Icon name={n.icon} />{n.label}
              </a>
            ))}
          </nav>
        </Window>

        <Window title={`${new URL(Astro.site!).host}${path}`} icon="page" class="main" tag="main">
          <slot />
        </Window>

        <Window title="status" icon="sun" class="status" persist="status">
          <dl class="stat">
            <dt>your time</dt><dd id="st-time">--:--</dd>
            <dt>sky</dt><dd id="st-sky">…</dd>
            <dt>weather</dt><dd id="st-weather">…</dd>
            <dt>visits</dt><dd id="st-visits">1st</dd>
          </dl>
          <div class="stat-btns">
            <button type="button" class="btn" id="st-lapse" aria-pressed="false">
              <span class="on"><Icon name="stop" /> stop</span><span class="off"><Icon name="ffwd" /> time-lapse</span>
            </button>
            <button type="button" class="btn" data-sound aria-pressed="true">
              <span class="on"><Icon name="soundOn" /> sound on</span><span class="off"><Icon name="soundOff" /> sound off</span>
            </button>
            <button type="button" class="btn" data-glass-toggle aria-pressed="true">
              <span class="on"><Icon name="glass" /> see-through</span><span class="off"><Icon name="glass" /> solid</span>
            </button>
            <button type="button" class="btn" data-bloom-toggle aria-pressed="true">
              <span class="on"><Icon name="firework" /> bloom on</span><span class="off"><Icon name="firework" /> bloom off</span>
            </button>
          </div>
        </Window>
        <Window title="radio" icon="radio" class="radio-win" persist="radio">
          <Radio />
        </Window>
      </div>

      <div class="scene-gap" aria-hidden="true"></div>

      <footer class="foot">
        <div class="badges">
          <a class="b88-own" href="/" title={`${SITE.title}'s homepage`}><img src="/button.svg" width="88" height="31" alt={`${SITE.title}`} /></a>
          {BLOGROLL.map((b) => <Badge88 name={b.name} href={b.url} img={b.button} />)}
        </div>
        <div class="foot-row window">
          <span>© {new Date().getFullYear()} {SITE.author} · hand-made, no trackers</span>
          <span class="foot-links">
            {BLOGROLL.length > 0 && (
              <button type="button" class="btn" data-random={JSON.stringify(BLOGROLL.map((b) => b.url))}><Icon name="dice" />random cool site</button>
            )}
            <a href="/blogroll.opml">opml</a>
            <a href={SITE.github}>github</a>
          </span>
        </div>
      </footer>
    </div>

    <script>
      import '../scripts/clicky';

      // Navigation swaps the <html> attributes for the new page's. Carry over the ones the
      // sky and the toggles set at runtime, so nothing flashes back to defaults.
      document.addEventListener('astro:before-swap', (e) => {
        const from = document.documentElement.dataset, to = e.newDocument.documentElement.dataset;
        for (const k of ['phase', 'weather', 'bloom', 'glass', 'mc'] as const) if (from[k]) to[k] = from[k];
      });

      const pad = (n: number) => String(n).padStart(2, '0');
      const timeEl = document.getElementById('st-time')!, skyEl = document.getElementById('st-sky')!;
      const weatherEl = document.getElementById('st-weather')!;
      const show = (h: number) => {
        const mins = Math.floor(h * 60);
        timeEl.textContent = `${pad(Math.floor(mins / 60) % 24)}:${pad(mins % 60)}`;
        skyEl.textContent = window.__skyMath(h).label;
      };
      addEventListener('skychange', (e) => { show(e.detail.h); weatherEl.textContent = e.detail.weather; });
      show(window.__skyOverride ?? window.__skyHour()); // don't wait for the first frame
      weatherEl.textContent = document.documentElement.dataset.weather ?? '…';
      // On phones, the status and radio windows start minimized (tap _ to open), so the
      // content comes first and more of the scene shows. Only on the first visit.
      if (matchMedia('(max-width: 760px)').matches) {
        try {
          if (!sessionStorage.getItem('mobile-collapsed')) {
            sessionStorage.setItem('mobile-collapsed', '1');
            for (const w of document.querySelectorAll<HTMLElement>('.status, .radio-win')) {
              w.classList.add('collapsed');
              w.querySelector('[data-win="min"]')?.setAttribute('aria-expanded', 'false');
            }
          }
        } catch {}
      }

      const lapseBtn = document.getElementById('st-lapse')!;
      lapseBtn.addEventListener('click', () => dispatchEvent(new Event('sky:timelapse')));
      addEventListener('sky:lapse', (e) => lapseBtn.setAttribute('aria-pressed', String(e.detail)));

      // A personal visit counter, kept only in this browser.
      try {
        let v = Number(localStorage.getItem('visits') || 0);
        if (!sessionStorage.getItem('counted')) { v++; localStorage.setItem('visits', String(v)); sessionStorage.setItem('counted', '1'); }
        const s = ['th', 'st', 'nd', 'rd'], r = v % 100;
        document.getElementById('st-visits')!.textContent = `${v}${s[(r - 20) % 10] || s[r] || s[0]}`;
      } catch {}
    </script>
  </body>
</html>

<style>
  .page { width: min(100% - 24px, 960px); margin: 0 auto; padding: 28px 0 40px; }

  .banner { text-align: center; margin-bottom: 18px; }
  .site-title {
    font: 700 clamp(30px, 7vw, 54px)/1 var(--pixel); color: #fff; text-decoration: none;
    text-shadow: 3px 3px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
  }
  .site-title:hover { color: #ffe066; }
  .sub { margin: 10px 0 0; color: #fff; font: 600 15px var(--pixel); text-shadow: 2px 2px 0 #000; }

  .marquee { overflow: hidden; white-space: nowrap; margin-bottom: 16px; padding: 5px 0; font: 600 13px var(--pixel); }
  .marquee span { display: inline-block; padding-left: 100%; animation: marquee 32s linear infinite; }
  .marquee:hover span { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .marquee span { padding-left: 12px; white-space: normal; } }

  .layout {
    display: grid; gap: 16px; align-items: start;
    grid-template-columns: 190px minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    grid-template-areas: 'nav main' 'status main' 'radio main' '. main';
  }
  .layout > :global(.nav) { grid-area: nav; }
  .layout > :global(.main) { grid-area: main; min-height: 60vh; }
  .layout > :global(.status) { grid-area: status; }
  .layout > :global(.radio-win) { grid-area: radio; }
  .nav-btns { display: flex; flex-direction: column; gap: 6px; }
  .nav-btns .btn { justify-content: flex-start; }

  .stat { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; margin: 0 0 12px; font-size: 12px; }
  .stat dt { color: var(--win-muted); }
  .stat dd { margin: 0; font: 600 13px var(--pixel); }
  .stat-btns { display: flex; flex-direction: column; gap: 6px; }
  .stat-btns .btn { font-size: 12px; padding: 6px 8px; }

  .scene-gap { display: none; } /* phones only, below */
  @media (max-width: 760px) {
    .page { padding-top: 18px; }
    .banner { margin-bottom: 12px; }
    .layout { gap: 12px; grid-template-columns: minmax(0, 1fr); grid-template-rows: none; grid-template-areas: 'nav' 'main' 'radio' 'status'; }
    /* navigation: one swipeable row instead of a wrapped block */
    .nav-btns { flex-direction: row; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: -2px; padding: 2px; }
    .nav-btns::-webkit-scrollbar { display: none; }
    .nav-btns .btn { flex: none; }
    .layout > :global(.nav) .win-body { padding: 8px; }
    .layout > :global(.main) { min-height: 0; }
    .stat-btns { flex-direction: row; flex-wrap: wrap; }
    /* room at the end of the page to look at the valley, like reaching the ground */
    .scene-gap { display: block; height: 42svh; }
  }

  .foot { margin-top: 24px; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 14px; }
  .b88-own img { image-rendering: pixelated; }
  .b88-own:active { transform: translate(1px, 1px); }
  .foot-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 8px 12px; font-size: 12px; }
  .foot-links { display: flex; align-items: center; gap: 12px; }
  .foot-links .btn { font-size: 12px; padding: 5px 8px; }
</style>
