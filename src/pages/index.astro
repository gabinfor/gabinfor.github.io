---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GpuBlobs from '../components/GpuBlobs.astro';
import PostList from '../components/PostList.astro';
import FriendsFeed from '../components/FriendsFeed.astro';
import { SITE } from '../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 5);
---
<Base>
  <section class="hero">
    <div class="copy">
      <p class="meta">Personal site · est. 2026</p>
      <h1>Hi, I'm {SITE.author}. I make <em class="accent">small worlds</em> on the web.</h1>
      <p class="lede">Notes on code, graphics, and whatever I'm tinkering with. Move your cursor over the blobs, they're rendered live with WebGPU.</p>
    </div>
    <GpuBlobs height="min(60vh, 480px)" />
  </section>

  <h2 class="section-label meta">Latest writing</h2>
  <PostList posts={posts} />
  <p class="mono"><a href="/blog/">All posts →</a></p>

  <h2 class="section-label meta">From blogs I read</h2>
  <FriendsFeed limit={6} />
  <p class="mono"><a href="/blogroll/">The whole blogroll →</a></p>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 2rem; padding-top: 2rem; }
  .lede { font-size: 1.25rem; color: var(--ink-2); max-width: 36ch; }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; } }
</style>
